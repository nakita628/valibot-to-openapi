{
  "name": "valibot-to-openapi",
  "version": "0.0.1",
  "description": "Builds OpenAPI 3.0 / 3.1 / 3.2 documents from Valibot schemas — zero runtime and type dependencies besides valibot",
  "keywords": [
    "json-schema",
    "openapi",
    "typescript",
    "valibot"
  ],
  "homepage": "https://github.com/nakita628/valibot-to-openapi",
  "bugs": {
    "url": "https://github.com/nakita628/valibot-to-openapi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakita628/valibot-to-openapi.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./valibot": {
      "types": "./dist/valibot.d.ts",
      "import": "./dist/valibot.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.1.1",
    "valibot": "^1.4.2"
  },
  "peerDependencies": {
    "valibot": "^1.0.0"
  }
}
